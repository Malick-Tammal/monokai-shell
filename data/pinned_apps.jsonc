//---------------------------------------------------------
//--  HACK: Dock pinned apps
//---------------------------------------------------------
//  INFO: Usage:
//    - Add a new object to the array
//    - The "class" property is the class name of the app "required"
//    - The "exec" property is the command to run the app "optional"
//    - To get the class name of an app, use the "hyprctl clients" command
//
//  INFO: EXAMPLE:
//    { "class": "io.github.kolunmi.Bazaar" },
//    { "class": "org.gnome.Nautilus", "exec": "nautilus --new-window" },
//    { "class": "firefox" },
//    { "class": "kitty" },
//    { "class": "neovim", "exec": "kitty --class neovim -e nvim" },

[
  { "class": "io.github.kolunmi.Bazaar" },
  { "class": "org.gnome.Nautilus", "exec": "nautilus --new-window" },
  { "class": "firefox" },
  { "class": "kitty" },
  { "class": "neovim", "exec": "kitty --class neovim -e nvim" },
  { "class": "code" },
  { "class": "codium" },
  { "class": "figma-linux" },
  { "class": "org.upscayl.Upscayl" },
  { "class": "org.inkscape.Inkscape" },
  { "class": "obsidian" },
  { "class": "io.github.alainm23.planify" },
  { "class": "steam" },
  { "class": "discord" },
  { "class": "vesktop" },
  { "class": "vlc" }
]
